# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/

/out/

# production
/build

# misc
.DS_Store
*.pem

# claude code
CLAUDE.md
AGENTS.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# auth database
sqlite.db

# reception and feedback tracking
/reception

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Working notes, plans and drafts — never public (Aug 3, 2026).
# Planning, job-search and launch material stays out of git; files live on disk only.
/docs/*
!/docs/architecture.md
!/docs/maintenance.md

# Holdings pipeline intermediate artifacts — per holdings-plan guardrail.
/data/holdings-staging/
data/meta/ask-log.jsonl

# Internal working documents: research briefs, plans, verification session
# output and peer-review notes. Public-facing documentation lives in README.md
# and on the site itself.
/research/
/.claude/
/data/meta/adjudication-notes-*.md
/data/meta/reverify-reports/
/data/meta/reverify-history/

# Audit working papers and any other root-level notes stay private (Sep 11).
/CODEBASE_AUDIT*.md
/*.md
!/README.md
