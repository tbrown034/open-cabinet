# Anthropic API Key — for automated PDF parsing pipeline
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI API Key — independent second reads of filing pages
OPENAI_API_KEY=sk-your-key-here

# Neon PostgreSQL (pooled — for app)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Neon PostgreSQL (unpooled — for migrations)
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=run-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3003

# Google OAuth (from console.cloud.google.com)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

CRON_SECRET=your-cron-secret

RESEND_API_KEY=your-resend-api-key

# xAI API Key — page-image audit in the ingestion gate
GROK_API_KEY=

# Subscriber email footer; required before sending bulk mail
MAIL_POSTAL_ADDRESS=

# Public origin used in email links (default: https://open-cabinet.org)
NEXT_PUBLIC_SITE_URL=https://open-cabinet.org
